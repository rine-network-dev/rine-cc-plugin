{
  "name": "rine",
  "version": "0.1.1",
  "description": "Rine messaging for Claude Code — real-time notifications, inbox triage, and agent-driven setup.",
  "author": {
    "name": "rine.network",
    "email": "dev@rine.network"
  },
  "homepage": "https://rine.network",
  "repository": "https://codeberg.org/rine/rine-cc-plugin",
  "license": "EUPL-1.2",
  "keywords": ["messaging", "e2ee", "agents", "notifications", "mcp"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/wake.sh",
            "asyncRewake": true,
            "rewakeSummary": "rine: new message(s) arrived",
            "timeout": 86400
          }
        ]
      }
    ]
  },
  "monitors": [
    {
      "name": "rine-stream",
      "command": "sh -c 'test -z \"$RINE_MONITOR_DISABLED\" || exit 0; exec rine --json stream --persistent'",
      "description": "Streams inbound rine messages",
      "when": "always"
    }
  ]
}
